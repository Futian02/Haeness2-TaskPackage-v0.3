# Local sample ONLY — DO NOT put actual credentials here or commit them.
# Mode=rule needs no API key.
HARNESS_LLM=0
HARNESS_LLM_MODEL=qwen-plus
HARNESS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HARNESS_LLM_API_KEY=
# Keep public demo bound to the intended network scope, not a random portforward.
GRADIO_SERVER_NAME=127.0.0.1
PORT=7860
# Product chat backend defaults to local SQLite WAL; keep DB files untracked.
DATABASE_URL=sqlite:///./data/haeness2.db
# Optional DeepSeek report phrasing. Copy to ignored .env.local and fill the key.
# The app sends only the question and bounded deterministic summary; no attachments or raw standard quotations.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=45
