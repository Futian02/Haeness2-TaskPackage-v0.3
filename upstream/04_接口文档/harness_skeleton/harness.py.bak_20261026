def build_registry() -> ToolRegistry:
    """TODO: 学生把 mock 函数替换成真正查 clauses.jsonl 的实现。
    参数表要和《工具接口规范》完全一致,不得增删改名。"""
    reg = ToolRegistry()
    reg.register(ToolSpec(
        name="damage_mechanism_query",
        func=_mock_damage_mechanism_query,
        description="按材质/介质/工况识别可能的损伤机理,并给出鉴别依据",
        parameters={
            "material": {"type": "string", "required": True},
            "medium": {"type": "array", "required": True},
            "temperature_c": {"type": "number", "required": False},
            "equipment_type": {"type": "string", "required": False},
            "evidence": {"type": "object", "required": False},
        },
    ))
    reg.register(ToolSpec(
        name="rbi_lookup",
        func=_mock_rbi_lookup,
        description="按设备/材质/机理查询风险等级与检验周期建议",
        parameters={
            "equipment_type": {"type": "string", "required": True},
            "material": {"type": "string", "required": True},
            "mechanism": {"type": "string", "required": False},
            "medium": {"type": "array", "required": False},
            "temperature_c": {"type": "number", "required": False},
            "pressure_mpa": {"type": "number", "required": False},
            "service_years": {"type": "number", "required": False},
        },
    ))
    reg.register(ToolSpec(
        name="standard_clause_search",
        func=_mock_standard_clause_search,
        description="按关键词或现象描述检索条款,兜底用",
        parameters={
            "keyword": {"type": "string", "required": True},
            "knowledge_type": {"type": "string", "required": False, "enum": ["rbi", "damage_mechanism"]},
            "top_k": {"type": "number", "required": False, "maximum": 20},
        },
    ))
    return reg


