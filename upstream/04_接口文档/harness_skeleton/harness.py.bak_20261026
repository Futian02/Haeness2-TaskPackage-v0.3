def _mock_damage_mechanism_query(material, medium, temperature_c=None, **kw):
    if temperature_c is not None and temperature_c > 400:
        return make_response(
            status="out_of_domain",
            in_domain=False,
            message="查询温度超出本条款覆盖区间(常温~400℃)",
        )
    return make_response(
        result={
            "mechanisms": [{
                "name": "盐酸腐蚀",
                "clause_id": "GBT30579-2022-5.1",
                "description": "示例数据,学生替换为真实条款库查询结果",
                "morphology": ["均匀腐蚀", "局部腐蚀"],
                "affected_materials": ["碳钢", "低合金钢", "300系列不锈钢", "400系列不锈钢"],
                "influencing_factors": ["盐酸浓度", "温度"],
                "susceptible_locations": ["常压塔塔顶管道与热交换器"],
                "prevention": ["注水", "注中和剂", "注缓蚀剂"],
                "detection_methods": ["定点测厚", "监测pH、铁离子和氯化物含量"],
                "related_damages": ["氯化铵腐蚀", "氯化物应力腐蚀开裂"],
                "match_level": "high",
            }],
            "discriminator": "需补充塔顶水 pH、注水点位置与沉积物情况以区分氯化铵腐蚀",
            "excluded": [],
        },
        source=[{
            "clause_id": "GBT30579-2022-5.1",
            "standard_code": "GB/T 30579-2022",
            "clause_no": "5.1",
            "page": 2,
        }],
    )


