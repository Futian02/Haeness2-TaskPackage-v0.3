def make_mock_planner(with_bad_call: bool):
    """假的决策器。with_bad_call=True 时第 2 步故意调用不存在的工具,演示护栏拦截。"""
    plan = [
        {"thought": "先根据材质与介质确定候选损伤机理", "tool": "damage_mechanism_query",
         "args": {"material": "碳钢", "medium": ["HCl", "氯化铵"], "temperature_c": 110}},
        {"thought": "区分盐酸腐蚀与氯化铵腐蚀,检索结盐相关条款", "tool": "standard_clause_search",
         "args": {"keyword": "氯化铵 结盐 注水", "knowledge_type": "damage_mechanism"}},
        {"thought": "查风险等级", "tool": "rbi_lookup",
         "args": {"equipment_type": "空冷器", "material": "碳钢", "mechanism": "氯化铵腐蚀", "service_years": 8}},
    ]
    if with_bad_call:
        plan.insert(1, {"thought": "故意调用一个不存在的工具,验证护栏能否拦住", "tool": "no_such_tool", "args": {}})

    def planner(task_input, history):
        if len(history) < len(plan):
            return plan[len(history)]
        return {
            "thought": "依据已足够,给出结论",
            "final_answer": {
                "conclusion": "示例结论。真实结论中每条断言后必须标注依据(依据 GBT30579-2022-5.1)。",
                "basis": ["GBT30579-2022-5.1"],
            },
        }
    return planner


if __name__ == "__main__":
    for stream in (__import__("sys").stdout,):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8")
    out_dir = Path(__file__).resolve().parent / "runs"
    h = Harness(build_registry())

    # 演示 1:含一次被拦截的调用
    traj = h.run(traj_id="DEMO-0001", task_input=dict(DEMO_INPUT), planner=make_mock_planner(True))
    save_jsonl(out_dir / "demo_run_log.jsonl", [traj.to_dict()])
    print(json.dumps(traj.to_dict(), ensure_ascii=False, indent=2))
    print("\n--- 检查点(演示 1) ---")
    print(f"轮次: {len(traj.steps)}  (指标要求支持 >=5 轮)")
    print(f"被拦截步数: {sum(1 for s in traj.steps if s.blocked)}  (应为 1,即那个不存在的工具)")
    try:
        traj.to_record()
    except DatasetExportError as e:
        print(f"导出数据集: 已拒绝。{e}")

    # 演示 2:三次正常调用,可导出为数据集记录
    traj2 = h.run(traj_id="DEMO-0002", task_input=dict(DEMO_INPUT), planner=make_mock_planner(False))
    path = save_jsonl(out_dir / "demo_trajectories.jsonl", [traj2.to_record()])
    print("\n--- 检查点(演示 2) ---")
    print(f"轨迹类型: {traj2.to_record()['task_type']},已写出 {path}")
    print("可在任务包根目录运行:python 04_接口文档/validate.py "
          "--clauses 03_案例样例/clauses.jsonl --trajectories 04_接口文档/harness_skeleton/runs/demo_trajectories.jsonl")
